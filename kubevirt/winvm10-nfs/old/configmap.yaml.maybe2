apiVersion: v1
kind: ConfigMap
metadata:
  name: intel-vgpu-configmap
data:
  intel-vgpu-pci-location.sh: |
    #!/usr/bin/env bash
    tempFile1=`mktemp --dry-run`
    echo $4 | sed "s/<address type='pci' domain='0x0000' bus='0x08'.*/<address type='pci' domain='0x0000' bus='0x00' slot='0x02' function='0x0'\/>/g" > $tempFile1
    cat $tempFile1
