prometheus:
  enabled: true
  prometheusSpec:
    additionalScrapeConfigs: |
      - job_name: prometheus
        static_configs:
          - targets:
            - 10.1.1.12:9000
            - 10.1.1.12:9400
            - 10.1.1.12:9199
            - 10.1.1.13:9000
            - 10.1.1.14:9000
            - 192.168.42.1:9100
            - 192.168.42.8:9100
            - 192.168.42.254:9100
            - 192.168.42.201:9100
      - job_name: myapp
        static_configs: 
          - targets: ["myapp-service:3000"]
      - job_name: kasa
        static_configs:
          - targets:
            # IP of your smart plugs
            - 192.168.42.253
        metrics_path: /scrape
        relabel_configs:
          - source_labels : [__address__]
            target_label: __param_target
          - source_labels: [__param_target]
            target_label: instance
          - target_label: __address__
           # IP of the exporter
           replacement: 192.168.42.8:9233
      - job_name: kasa_exporter
        static_configs:
          - targets:
            - 192.168.42.8:9233
        
