apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  creationTimestamp: null
  labels:
    kubevirt.io/vm: fedora-build 
  name: fedora-build
spec:
  dataVolumeTemplates:
  - metadata:
      creationTimestamp: null
      name: fedora-build-volume
    spec:
      storage:
        accessModes:
        - ReadWriteOnce
        resources:
          requests:
            storage: 512G
        storageClassName: longhorn 
      source:
        http:
          url: https://download.fedoraproject.org/pub/fedora/linux/releases/40/Cloud/x86_64/images/Fedora-Cloud-Base-Generic.x86_64-40-1.14.qcow2
  running: false 
  template:
    metadata:
      labels:
        kubevirt.io/vm: fedora-build
        prometheus.kubevirt.io: "node-exporter" 
    spec:
      domain:
        cpu:
          sockets: 1
          cores: 2
          threads: 2
        devices:
          # Remove the comment below when you have XRDP setup
          #autoattachGraphicsDevice: false
          gpus:
          - deviceName: intel.com/sriov-gpudevice
            name: gpu1
          disks:
          - disk:
              bus: virtio
            name: feodra-build-data-volume-pv
        machine:
          type: ""
        resources:
          requests:
            cpu: 4
            memory: 12G
      terminationGracePeriodSeconds: 180
      volumes:
      - dataVolume:
          name: fedora-build-volume 
        name: fedora-build-data-volume-pv
      - cloudInitNoCloud:
          userData: |-
            #cloud-config
            resize_rootfs: true
            hostname: acramentum
            manage_etc_hosts: true
            users:
            - name: sparky
              groups: wheel
              sudo: ['ALL=(ALL) NOPASSWD:ALL']
              shell: /bin/bash
              ssh-authorized-keys:
                - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKvK2k0mlFDzMapqdwD788BOIO24+clI1Q0k7KTmx+uZ sparky@torino
            - name: celes
              groups: wheel
              sudo: ['ALL=(ALL) NOPASSWD:ALL']
              shell: /bin/bash
              ssh-authorized-keys:
                - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEqvp+XbCqCMFZiflp+2gkRjORFp2RkN5o+LvRb2kjL9 celes@esnixi
              package_update: true
              packages:
               - git
               - vim
              runcmd:
               - systemctl enable sshd.service
        name: cloudinit
status: {}
