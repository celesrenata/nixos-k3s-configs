apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: rb-http
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web
    traefik.ingress.kubernetes.io/router.middlewares: default-redirectscheme@kubernetescrd
  labels:
    app: reviewboard
spec:
  rules:
    - host: cr.startup.celestium.life
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: reviewboard
                port:
                  number: 8080
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: rb-https
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    cert-manager.io/cluster-issuer: startup-le-production 
  labels:
    app: reviewboard
spec:
  rules:
    - host: cr.startup.celestium.life
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: reviewboard
                port:
                  number: 8080
  tls:
    - hosts:
        - cr.startup.celestium.life
      secretName: startup-rb-cert
